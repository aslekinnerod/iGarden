rules_version = '2';

// Plantebilder: gardens/{gardenId}/plants/{plantId}/{photoId}.jpg
// Samme medlemskapssjekk som Firestore-reglene.
service firebase.storage {
  match /b/{bucket}/o {
    match /gardens/{gardenId}/{allPaths=**} {
      allow read: if request.auth != null
        && firestore.exists(/databases/(default)/documents/gardens/$(gardenId)/members/$(request.auth.uid));
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/gardens/$(gardenId)/members/$(request.auth.uid))
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
  }
}
