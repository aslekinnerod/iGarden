    },
    "%@ (pH %@) er for kalkrikt – planten vil ha pH %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (pH %2$@) is too alkaline – the plant prefers pH %3$@."
          }
        }
      }
    },
    "%@ (pH %@) er for surt – planten vil ha pH %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (pH %2$@) is too acidic – the plant prefers pH %3$@."
